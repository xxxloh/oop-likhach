<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Chat.Client.LoginWindow"
        Title="Онлайн-чат — вход"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        Background="#F4F6FB"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Background" Value="#4F6EF7" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3E5BE0" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Window.Styles>

  <Border Margin="20" Padding="22" CornerRadius="16" Background="White"
          BorderBrush="#D9DEEA" BorderThickness="1">
    <StackPanel Spacing="8">
      <TextBlock Text="Онлайн-чат" FontSize="24" FontWeight="SemiBold" Foreground="#1F2A44" />
      <TextBlock Text="Подключитесь к серверу и выберите ник" Foreground="#6B7490"
                 TextWrapping="Wrap" Margin="0,0,0,8" />

      <TextBlock Text="Адрес сервера" Foreground="#1F2A44" />
      <TextBox x:Name="HostBox" Text="127.0.0.1" />

      <TextBlock Text="Порт" Foreground="#1F2A44" Margin="0,6,0,0" />
      <TextBox x:Name="PortBox" Text="5050" />

      <TextBlock Text="Ник (до 20 символов)" Foreground="#1F2A44" Margin="0,6,0,0" />
      <TextBox x:Name="NickBox" MaxLength="20" />

      <TextBlock x:Name="ErrorText" Foreground="#C0392B" TextWrapping="Wrap"
                 IsVisible="False" Margin="0,6,0,0" />

      <Button x:Name="ConnectButton" Content="Войти" HorizontalAlignment="Stretch"
              Margin="0,10,0,0" Click="ConnectButton_Click" />
    </StackPanel>
  </Border>
</Window>
