<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PaintApp"
        x:Class="PaintApp.MainWindow"
        Title="Графический редактор"
        Width="1100" Height="780"
        MinWidth="980" MinHeight="560"
        Background="#F4F6FB"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <!-- Кнопки -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Background" Value="#E6EAF4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#D5DBEA" />
    </Style>

    <!-- Кнопки инструментов: выбранный инструмент залит синим -->
    <Style Selector="ToggleButton">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Background" Value="#E6EAF4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#D5DBEA" />
    </Style>
    <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4F6EF7" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3E5BE0" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="18">

    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">

      <!-- Инструменты и толщина -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="Инструмент" VerticalAlignment="Center"
                   Margin="0,0,12,0" Foreground="#1F2A44" />
        <StackPanel x:Name="ToolsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
          <TextBlock x:Name="WidthLabel" VerticalAlignment="Center" MinWidth="95"
                     Foreground="#1F2A44" />
          <Slider x:Name="WidthSlider" Width="170" Minimum="1" Maximum="20" Value="3"
                  TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>

      <!-- Цвета (кружки создаются в коде) -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Цвет" VerticalAlignment="Center" Margin="0,0,12,0"
                   Foreground="#1F2A44" MinWidth="70" />
        <StackPanel x:Name="ColorsPanel" Orientation="Horizontal" />
      </StackPanel>

      <!-- Действия -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <Button x:Name="UndoButton" Content="Отменить" Click="UndoButton_Click" />
          <Button x:Name="RedoButton" Content="Повторить" Click="RedoButton_Click" />
          <Button x:Name="DeleteButton" Content="Удалить фигуру" Click="DeleteButton_Click" />
          <Button x:Name="ClearButton" Content="Очистить" Click="ClearButton_Click" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="OpenButton" Content="Открыть" Click="OpenButton_Click" />
          <Button x:Name="SaveButton" Content="Сохранить" Click="SaveButton_Click" />
          <Button x:Name="ExportButton" Content="Экспорт в PNG" Click="ExportButton_Click" />
        </StackPanel>
      </Grid>

    </StackPanel>

    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="4,10,0,0"
               Foreground="#6B7490" />

    <!-- Холст в скруглённой рамке. Border с фоном ловит мышь надёжно -->
    <Border CornerRadius="16" Background="White" BorderBrush="#D9DEEA"
            BorderThickness="1" ClipToBounds="True">
      <Border x:Name="CanvasHost" Background="White" Cursor="Cross">
        <local:DrawingCanvas x:Name="PaintCanvas" />
      </Border>
    </Border>

  </DockPanel>
</Window>
